#!/usr/bin/env python3
"""A stand-in for `claude`, for testing Spine's connector without Claude."""
import json, os, sys, time

args = sys.argv[1:]
home = os.environ.get("HOME", "")
signed_in_here = os.path.join(home, ".fake-claude-signed-in")
if args[:1] == ["--version"]:
    print("9.9.9 (Claude Code)")
    sys.exit(0)
if args[:2] == ["auth", "status"]:
    logged_in = os.environ.get("FAKE_CLAUDE_LOGGED_OUT") != "1" or os.path.exists(signed_in_here)
    print(json.dumps({"loggedIn": logged_in, "authMethod": "claude.ai" if logged_in else "none",
                      **({"subscriptionType": "max"} if logged_in else {})}, indent=2))
    sys.exit(0)
if args[:2] == ["auth", "login"]:
    # Anthropic's sign-in opens a browser; the fake just remembers it happened.
    open(signed_in_here, "w").close()
    print("Login successful.")
    sys.exit(0)

user = sys.stdin.read()
emit = lambda message: print(json.dumps(message), flush=True)
if os.environ.get("FAKE_PIDFILE"):
    with open(os.environ["FAKE_PIDFILE"], "w") as written:
        written.write(str(os.getpid()))
if os.environ.get("FAKE_CLAUDE_SLOW") == "1":
    time.sleep(30)
if os.environ.get("FAKE_CLAUDE_FAIL") == "limit":
    emit({"type": "result", "is_error": True, "result": "Claude AI usage limit reached|1791342600"})
    sys.exit(1)
if os.environ.get("FAKE_CLAUDE_FAIL") == "crash":
    sys.stderr.write("Error: something broke inside Claude Code\n")
    sys.exit(3)
model = args[args.index("--model") + 1] if "--model" in args else ""
system = args[args.index("--system-prompt") + 1] if "--system-prompt" in args else ""
schema = json.loads(args[args.index("--json-schema") + 1]) if "--json-schema" in args else None
fields = sorted((schema or {}).get("properties", {}))
reply = json.dumps({"echo": user[:24], "size": len(user.encode("utf-8")), "system": system[:20], "model": model,
                    "fields": fields, "cwd": os.path.basename(os.getcwd()), "tools": args[args.index("--tools") + 1] if "--tools" in args else None})
# With FAKE_CLAUDE_READS=1, real-looking notes, so a read in the browser finishes.
if os.environ.get("FAKE_CLAUDE_READS") == "1":
    import re
    if "keySentences" in fields:
        ids = re.findall(r"\b(s\d+)(?: \[lead\])?: ", user)
        reply = json.dumps({"keySentences": ids[::3], "collapseFolds": [], "sections": [], "chapters": []})
    elif "groupings" in fields:
        reply = json.dumps({"groupings": [], "carousels": []})
    else:
        runs = re.findall(r"^Run (\d+)$", user, re.M)
        reply = json.dumps({"bridges": [{"run": int(run), "text": "And so the thread carries on."} for run in runs]})
emit({"type": "system", "subtype": "init", "tools": ["StructuredOutput"], "model": model})
if os.environ.get("FAKE_CLAUDE_RETRY") == "1":
    # A first try that Claude Code turns down, before the real answer.
    emit({"type": "stream_event", "event": {"type": "content_block_start", "content_block": {"type": "tool_use", "name": "StructuredOutput"}}})
    emit({"type": "stream_event", "event": {"type": "content_block_delta", "delta": {"type": "input_json_delta", "partial_json": "{\"wrong\": tru"}}})
    emit({"type": "stream_event", "event": {"type": "content_block_stop"}})
emit({"type": "stream_event", "event": {"type": "content_block_start", "content_block": {"type": "thinking"}}})
emit({"type": "stream_event", "event": {"type": "content_block_delta", "delta": {"type": "thinking_delta", "thinking": "Hmm."}}})
emit({"type": "stream_event", "event": {"type": "content_block_stop"}})
emit({"type": "stream_event", "event": {"type": "content_block_start", "content_block": {"type": "tool_use", "name": "StructuredOutput"}}})
for at in range(0, len(reply), 7):
    emit({"type": "stream_event", "event": {"type": "content_block_delta", "delta": {"type": "input_json_delta", "partial_json": reply[at:at + 7]}}})
emit({"type": "stream_event", "event": {"type": "content_block_stop"}})
print("Some line that isn't JSON", flush=True)
emit({"type": "result", "subtype": "success", "is_error": False, "result": reply, "structured_output": json.loads(reply),
      "usage": {"input_tokens": 12, "output_tokens": 34}})
