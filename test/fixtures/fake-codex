#!/usr/bin/env python3
"""A stand-in for `codex`, for testing Spine's native host without Codex."""
import json, os, sys

args = sys.argv[1:]
if args[:1] == ["--version"]:
    print("codex-cli 9.9.9")
    sys.exit(0)
if args[:2] == ["login", "status"]:
    if os.environ.get("FAKE_CODEX_LOGGED_OUT") == "1":
        print("Not logged in")
        sys.exit(1)
    print("Logged in using ChatGPT")
    sys.exit(0)

prompt = sys.stdin.read()
emit = lambda message: print(json.dumps(message), flush=True)
emit({"type": "thread.started", "thread_id": "fake"})
emit({"type": "turn.started"})
if os.environ.get("FAKE_CODEX_FAIL") == "limit":
    emit({"type": "turn.failed", "error": {"message": "You've hit your usage limit. Try again later."}})
    sys.exit(1)
schema = json.load(open(args[args.index("--output-schema") + 1])) if "--output-schema" in args else {}
effort = next((a for a in args if a.startswith("model_reasoning_effort=")), "")
answer = json.dumps({"echo": prompt.split("\n\n")[-1][:24], "effort": effort, "fields": sorted(schema.get("properties", {})), "ignoresConfig": "--ignore-user-config" in args})
emit({"type": "item.completed", "item": {"id": "item_0", "type": "agent_message", "text": answer}})
emit({"type": "turn.completed", "usage": {"input_tokens": 50, "output_tokens": 20}})
